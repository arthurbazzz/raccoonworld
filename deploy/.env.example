# Public IP of the VPS in production (e.g. 203.0.113.10); localhost for the local stack.
PUBLIC_HOST=localhost
# Commit SHA of the images; the deploy workflow sets it.
IMAGE_TAG=latest
POSTGRES_USER=raccoon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=raccoonworld
