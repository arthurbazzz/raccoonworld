  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "eslint-config-prettier": "10.1.8",
    "playwright-bdd": "9.2.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "^5",
    "vitest": "3.2.7"
  }
